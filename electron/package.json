{
  "name": "heroes3-hota-companion",
  "productName": "Heroes 3 HotA Companion",
  "version": "0.1.3",
  "description": "Interactive map companion for Heroes of Might and Magic III: Horn of the Abyss. Parses any HotA map from your install: map viewer, route finder, savegame import.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "sync": "rm -rf app && cp -r ../app app",
    "dist": "npm run sync && electron-builder --win --linux"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "@electron/packager": "18.3.6",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.michalkasarda.hotacompanion",
    "productName": "Heroes 3 HotA Companion",
    "artifactName": "Heroes3HotaCompanion-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "updater.js",
      "package.json",
      "README.txt",
      "app/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Heroes 3 HotA Companion"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "maintainer": "michal <cigaaaaan@gmail.com>",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "michalkasarda",
      "repo": "Heroes3HotaCompanion",
      "releaseType": "release"
    }
  },
  "author": "michal",
  "homepage": "https://github.com/michalkasarda/Heroes3HotaCompanion",
  "repository": {
    "type": "git",
    "url": "https://github.com/michalkasarda/Heroes3HotaCompanion.git"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}